# Windows PowerShell 5.1 needs UTF-8 *with BOM* to read accents correctly.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

# Pages launcher: runs through "irm | iex", and a BOM breaks iex. No BOM (the file is ASCII only).
[web/launcher.ps1]
charset = utf-8

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{md,yml,svg,html}]
charset = utf-8
indent_style = space
indent_size = 2
